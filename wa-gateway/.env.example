# ============================================================
# SIM Mendunia - WhatsApp Gateway (Baileys)
# Copy file ini menjadi `.env` lalu sesuaikan nilainya.
# ============================================================

# Port HTTP untuk REST API gateway
PORT=4300

# Token akses API (dipakai oleh backend Laravel). Gunakan string acak yang kuat.
GATEWAY_TOKEN=ubah-saya-dengan-token-acak

# Base URL backend Laravel (untuk webhook status & pesan masuk)
# Contoh: https://api.mendunia.id
BACKEND_BASE_URL=http://localhost:8000

# Secret untuk auth webhook ke Laravel (sama dengan WA_GATEWAY_WEBHOOK_SECRET di .env backend)
BACKEND_WEBHOOK_SECRET=mendunia-gateway-secret

# Direktori penyimpanan sesi (auth state Baileys per device)
SESSION_DIR=./sessions

# Maksimum ukuran payload JSON (bytes)
MAX_PAYLOAD=1048576

# ===== Pengamanan pengiriman (anti-flag/spam WhatsApp) =====
# Semakin konservatif, semakin aman. Nilai default aman untuk notifikasi ringan.

# Jarak minimum antar pesan (ms). Kenaikan = area aman lebih besar, tapi throughput turun.
SEND_MIN_INTERVAL_MS=3000

# Jitter acak tambahan (ms) agar pola pengiriman terlihat natural (bukan bot).
SEND_JITTER_MS=1000

# Batas jumlah kirim per device per periode. Jika tercapai, pesan ditunda sampai jendela reset.
SEND_MAX_PER_MINUTE=20
SEND_MAX_PER_HOUR=200
SEND_MAX_PER_DAY=1000