# ============================================================
# Frontend - variabel env yang dibaca Vite (prefix VITE_)
# ============================================================
# Salin file ini menjadi `frontend/.env` untuk build development,
# atau `frontend/.env.production` untuk build produksi (`npm run build`).
#
# URL dasar API backend Laravel (tanpa trailing slash).
# - Development (vite dev / `npm run dev`): kosongkan agar default
#   http://localhost:8000/api terpakai.
# - Production: pakai URL domain backend, contoh:
#   VITE_API_URL=https://sim.mendunia.id/api
VITE_API_URL=