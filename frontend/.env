# ============================================================
# KONFIGURASI FRONTEND (aktif sekarang: LOKAL)
# ============================================================
VITE_API_URL=http://localhost:8080/api
VITE_APP_URL=http://localhost:8080
VITE_MIRAIGO_URL=http://localhost:5173/dashboard

# Realtime monitoring (Laravel Reverb)
VITE_REVERB_APP_KEY=mendunia-local-key
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8081
VITE_REVERB_SCHEME=http

